{{!
    @template theme_union_govbr/fatal_error

    Template for fatal error pages following Gov.br Design System guidelines.

    Example context (json):
    {
        "illustrationurl": "http://example.com/theme/image.php?image=illustrations/error/404",
        "badgeclass": "badge-govbr-404",
        "errorbadge": "Erro 404",
        "errortitle": "Página não encontrada",
        "errordescription": "O endereço que você tentou acessar não foi encontrado.",
        "errormessage": "",
        "homeurl": "http://example.com/",
        "homelabel": "Página Inicial",
        "backurl": "javascript:history.back()",
        "backlabel": "Voltar",
        "hasdebug": false
    }
}}
<div class="govbr-error-page text-center py-4 my-3 mx-auto">
    {{#illustrationurl}}
        <div class="govbr-error-illustration mb-4">
            <img src="{{{illustrationurl}}}" alt="" class="img-fluid" loading="lazy">
        </div>
    {{/illustrationurl}}

    {{#errorbadge}}
        <div class="govbr-error-badge mb-3">
            <span class="badge rounded-pill {{badgeclass}}">{{errorbadge}}</span>
        </div>
    {{/errorbadge}}

    <h1 class="govbr-error-title h2 fw-bold mb-3">{{errortitle}}</h1>

    <div class="govbr-error-description text-muted mb-4 fs-6">
        <p class="mb-2">{{errordescription}}</p>
        {{#errormessage}}
            <p class="govbr-error-custom-msg small text-secondary fw-semibold bg-light p-2 rounded border border-light mx-auto">{{errormessage}}</p>
        {{/errormessage}}
    </div>

    <div class="govbr-error-actions d-flex flex-wrap justify-content-center gap-3 mb-4">
        {{#loginurl}}
            <a href="{{{loginurl}}}" class="btn btn-primary px-4 py-2">
                <i class="fa fa-sign-in me-2" aria-hidden="true"></i> {{loginlabel}}
            </a>
        {{/loginurl}}
        <a href="{{{homeurl}}}" class="btn {{^loginurl}}btn-primary{{/loginurl}}{{#loginurl}}btn-secondary{{/loginurl}} px-4 py-2">
            <i class="fa fa-home me-2" aria-hidden="true"></i> {{homelabel}}
        </a>
        <button type="button" onclick="window.history.length > 1 ? window.history.back() : window.location.href='{{{homeurl}}}'" class="btn btn-secondary px-4 py-2">
            <i class="fa fa-arrow-left me-2" aria-hidden="true"></i> {{backlabel}}
        </button>
        {{#continuelink}}
            <a href="{{{continuelink}}}" class="btn btn-outline-primary px-4 py-2">
                {{#str}} continue, core {{/str}}
            </a>
        {{/continuelink}}
    </div>

    {{#hasdebug}}
        <div class="govbr-error-debug mt-5 text-start mx-auto">
            <details class="card border shadow-sm">
                <summary class="card-header bg-light py-2 px-3 user-select-none text-muted small fw-bold">
                    <i class="fa fa-terminal me-2" aria-hidden="true"></i> {{#str}} error_debug_title, theme_union_govbr {{/str}}
                </summary>
                <div class="card-body font-monospace small bg-white text-break">
                    {{#debugdata.errorcode}}
                        <div class="mb-2"><strong>{{#str}} error_debug_code, theme_union_govbr {{/str}}:</strong> <code>{{debugdata.errorcode}}</code></div>
                    {{/debugdata.errorcode}}
                    {{#debugdata.moreinfourl}}
                        <div class="mb-2"><strong>{{#str}} error_debug_moreinfo, theme_union_govbr {{/str}}:</strong> <a href="{{{debugdata.moreinfourl}}}" target="_blank" rel="noopener noreferrer">{{debugdata.moreinfourl}}</a></div>
                    {{/debugdata.moreinfourl}}
                    {{#debugdata.debuginfo}}
                        <div class="mb-2"><strong>Debug info:</strong> <pre class="bg-light p-2 rounded mt-1 mb-0">{{{debugdata.debuginfo}}}</pre></div>
                    {{/debugdata.debuginfo}}
                    {{#debugdata.backtrace}}
                        <div class="mb-2"><strong>Stack trace:</strong> <div class="bg-light p-2 rounded mt-1">{{{debugdata.backtrace}}}</div></div>
                    {{/debugdata.backtrace}}
                    {{#debugdata.obbuffer}}
                        <div class="mb-2"><strong>Output buffer:</strong> <pre class="bg-light p-2 rounded mt-1 mb-0">{{debugdata.obbuffer}}</pre></div>
                    {{/debugdata.obbuffer}}
                </div>
            </details>
        </div>
    {{/hasdebug}}
</div>
